/* The iconbar menu. */

menu(IconBarMenu, "Unify") {
	item("Info") {
		d_box(ProgInfo);
	}
	item("Help...");
	item("Quit");
}

/* The list window menu. */

menu(ListWindowMenu, "Unify") {
	item("File") {
		submenu(ListWindowFileMenu);
	}
	item("Test") {
		submenu(ListWindowTestMenu);
		dotted;
	}
	item("Save Logs") {
		d_box(SaveAs) {
			warning;
		}
	}
}

menu(ListWindowFileMenu, "File") {
	item("Info") {
		d_box(FileInfo) {
			warning;
		}
	}
	item("View Log...");
	item("Save Log") {
		d_box(SaveAs) {
			warning;
		}
	}
}

menu(ListWindowTestMenu, "Test") {
	item("Info");
}
